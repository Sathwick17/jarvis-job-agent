Preparing setup script reference
Preparing setup script reference
Here's the full setup script for once you're SSH'd into the VM:

bash
# SSH in first
ssh -i ~/.ssh/oracle_vm.pem ubuntu@<your-vm-public-ip>

# Update system
sudo apt update && sudo apt upgrade -y

# Install Docker
sudo apt install -y ca-certificates curl gnupg
sudo install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
sudo apt update
sudo apt install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
sudo usermod -aG docker $USER
newgrp docker

# Verify
docker --version

# Install Python + pip (for browser-use)
sudo apt install -y python3-pip python3-venv

# Install browser-use
python3 -m venv ~/browseruse-env
source ~/browseruse-env/bin/activate
pip install browser-use
